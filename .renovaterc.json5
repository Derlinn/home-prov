{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>home-operations/renovate-presets#4.0.0", ":timezone(Europe/Paris)"],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  customManagers: [
    {
      // The preset's `annotated` manager cannot read HCL syntax
      // (`key = "value"`, with spaces around the `=`), hence this dedicated manager.
      customType: "regex",
      description: "Talos version pinned in Terraform envs",
      managerFilePatterns: ["/^terraform/envs/[^/]+/(main\\.tf|terraform\\.tfvars\\.example)$/"],
      matchStrings: ["talos_version\\s*=\\s*\"(?<currentValue>v[^\"]+)\""],
      datasourceTemplate: "docker",
      depNameTemplate: "ghcr.io/siderolabs/installer",
    },
    {
      customType: "regex",
      description: "Kubernetes version pinned in Terraform envs",
      managerFilePatterns: ["/^terraform/envs/[^/]+/(main\\.tf|terraform\\.tfvars\\.example)$/"],
      matchStrings: ["kubernetes_version\\s*=\\s*\"(?<currentValue>v[^\"]+)\""],
      datasourceTemplate: "docker",
      depNameTemplate: "ghcr.io/siderolabs/kubelet",
    },
  ],
  packageRules: [
    // Auto-merge rules
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Renovate Presets",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    // Grouping rules
    {
      description: "Arr Stack Group",
      groupName: "arr-stack",
      matchDatasources: ["docker"],
      matchPackageNames: ["/bazarr/", "/prowlarr/", "/radarr/", "/sonarr/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Cert-Manager Group",
      groupName: "cert-manager",
      matchDatasources: ["docker"],
      matchPackageNames: ["/cert-manager/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
    },
    {
      // Unites the mise pin, the Terraform pin and the tuppr upgrade version.
      // `siderolabs/talos` covers the mise pin, `siderolabs/installer` covers
      // the TalosUpgrade CR and the Terraform locals.
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos", "/siderolabs\\/installer/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    // Breaking-change guardrails
    {
      // Longhorn n'autorise l'upgrade que d'une mineure a la suivante (regle
      // appliquee par le hook longhorn-pre-upgrade, qui echoue sinon).
      // Sans ceci, Renovate propose 1.10.1 -> 1.12.0 en sautant la 1.11.x.
      // separateMultipleMinor force un PR par palier de mineure.
      description: "Longhorn forbids skipping a minor version: one PR per step",
      matchDatasources: ["docker", "helm"],
      matchPackageNames: ["/longhorn/"],
      separateMultipleMinor: true,
    },
    {
      description: "Critical infrastructure majors need manual approval",
      matchDatasources: ["docker", "helm"],
      matchUpdateTypes: ["major"],
      matchPackageNames: [
        "siderolabs/talos",
        "/kubernetes/kubernetes/",
        "/cilium/",
        "/coredns/",
        "/cert-manager/",
        "/longhorn/",
        "/envoy-gateway/",
        "/flux-operator/",
        "/flux-instance/",
        "/authentik/",
        "/vaultwarden/",
        "/headscale/",
        "/kube-prometheus-stack/",
      ],
      dependencyDashboardApproval: true,
    },
    {
      description: "Let every other major settle before it reaches a PR",
      matchDatasources: ["docker", "helm"],
      matchUpdateTypes: ["major"],
      minimumReleaseAge: "7 days",
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}
